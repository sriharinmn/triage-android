<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 6 to 11 (API 26 to 30) full backup. allowBackup="false" already turns it off; this file makes the same
  decision explicit: nothing is backed up.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
